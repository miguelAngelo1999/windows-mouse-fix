;
; WmfVirtualPad.inf
; UMDF2 HID minidriver for Windows Mouse Fix Virtual Precision Touchpad.
;
; Based on VHidMini2 sample INF from Windows Driver Kit.
; Requires Windows 11 (build 22000+) for MsHidUmdf.inf support.
;
; Install: devcon install WmfVirtualPad.inf ROOT\WmfVirtualPad
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ManufacturerName%
CatalogFile = WmfVirtualPad.cat
DriverVer   = 05/29/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
WmfVirtualPad.dll = 1

; ---- Manufacturer / Models ----

[Manufacturer]
%ManufacturerName% = Standard, NTamd64.10.0...22000, NTarm64.10.0...22000

[Standard.NTamd64.10.0...22000]
%DeviceDesc% = WmfVirtualPad_Install, ROOT\WmfVirtualPad

[Standard.NTarm64.10.0...22000]
%DeviceDesc% = WmfVirtualPad_Install, ROOT\WmfVirtualPad

; ---- Install ----

[WmfVirtualPad_Install.NT]
CopyFiles = WmfVirtualPad_CopyFiles
Include   = MsHidUmdf.inf
Needs     = MsHidUmdf.NT
Include   = WUDFRD.inf
Needs     = WUDFRD_LowerFilter.NT

[WmfVirtualPad_Install.NT.HW]
Include = MsHidUmdf.inf
Needs   = MsHidUmdf.NT.HW
Include = WUDFRD.inf
Needs   = WUDFRD_LowerFilter.NT.HW
AddReg  = WmfVirtualPad_HW_AddReg

[WmfVirtualPad_HW_AddReg]
; Allow everyone read/write access to the device
HKR,,Security,,"D:P(A;;GA;;;WD)(A;;GA;;;RC)"

[WmfVirtualPad_Install.NT.Services]
Include = MsHidUmdf.inf
Needs   = MsHidUmdf.NT.Services
Include = WUDFRD.inf
Needs   = WUDFRD_LowerFilter.NT.Services

[WmfVirtualPad_Install.NT.Filters]
Include = WUDFRD.inf
Needs   = WUDFRD_LowerFilter.NT.Filters

[WmfVirtualPad_Install.NT.Wdf]
UmdfService              = WmfVirtualPad, WmfVirtualPad_UmdfService
UmdfServiceOrder         = WmfVirtualPad
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy     = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction  = Copy
UmdfFsContextUsePolicy   = CanUseFsContext2

[WmfVirtualPad_UmdfService]
UmdfLibraryVersion = 2.33.0
ServiceBinary      = %13%\WmfVirtualPad.dll

; ---- Copy Files ----

[WmfVirtualPad_CopyFiles]
WmfVirtualPad.dll

; ---- Strings ----

[Strings]
ManufacturerName = "Windows Mouse Fix"
DiskName         = "Windows Mouse Fix Driver Disk"
DeviceDesc       = "Windows Mouse Fix Virtual Precision Touchpad"
