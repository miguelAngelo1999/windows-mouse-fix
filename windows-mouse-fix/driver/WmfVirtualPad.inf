; WmfVirtualPad.inf
; Installation file for the Windows Mouse Fix Virtual Precision Touchpad driver.
;
; To install (test-signing mode):
;   1. bcdedit /set testsigning on  (reboot required)
;   2. pnputil /add-driver WmfVirtualPad.inf /install
;
; For release: submit to Microsoft Hardware Dev Center for attestation signing.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ManufacturerName%
CatalogFile = WmfVirtualPad.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
WmfVirtualPad.dll = 1,,

; ---- Manufacturer / Models ----

[Manufacturer]
%ManufacturerName% = Standard, NT$ARCH$

[Standard.NT$ARCH$]
%DeviceDesc% = WmfVirtualPad_Install, ROOT\WmfVirtualPad

; ---- Install ----

[WmfVirtualPad_Install.NT]
CopyFiles = WmfVirtualPad_CopyFiles

[WmfVirtualPad_CopyFiles]
WmfVirtualPad.dll

[WmfVirtualPad_Install.NT.Services]
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[WmfVirtualPad_Install.NT.Wdf]
UmdfService              = WmfVirtualPad, WmfVirtualPad_Install
UmdfServiceOrder         = WmfVirtualPad
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy     = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy   = CannotUseFsContexts

[WmfVirtualPad_Install]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\WmfVirtualPad.dll
UmdfBusDriverName  = WUDFRd

; ---- Device Interface ----

[WmfVirtualPad_Install.NT.Interfaces]
AddInterface = {4D1E55B2-F16F-11CF-88CB-001111000030},, WmfVirtualPad_Interface

[WmfVirtualPad_Interface]
AddProperty = WmfVirtualPad_Interface_AddProperty

[WmfVirtualPad_Interface_AddProperty]
; Mark as precision touchpad
{3EFBE9B5-E14B-4B23-9B3E-5B7B4B4B4B4B}, 2, 17,, 1

; ---- Strings ----

[Strings]
ManufacturerName  = "Windows Mouse Fix"
DiskName          = "Windows Mouse Fix Driver Disk"
DeviceDesc        = "Windows Mouse Fix Virtual Precision Touchpad"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
